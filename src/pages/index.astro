---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ExperienceCard from "@/components/ExperienceCard.astro";
import { proofPoints, education, siteConfig } from "@/data/site";
import { projects } from "@/data/projects";
import { experiences } from "@/data/experience";
import { hrefFor, withBase } from "@/utils/paths";
import { getImage } from "astro:assets";
import headshot from "@/assets/images/placeholders/Chris_Velez_Headshot.jpeg";

const headshotWebp = await getImage({ src: headshot, format: "webp", width: 600, quality: 75 });

const featuredProjects = projects.slice(0, 4);
const configuredSite = (Astro.site?.href ?? "https://crashpr0.github.io/ChrisVelezPortfolio/").replace(/\/$/, "");
const baseSuffix = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL.replace(/\/$/, "");
const siteRoot = (configuredSite.endsWith(baseSuffix) ? configuredSite : `${configuredSite}${baseSuffix}`) + "/";
const personJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.name,
  url: siteRoot,
  image: new URL(headshotWebp.src, configuredSite).href,
  email: siteConfig.email,
  jobTitle: "Computer Engineering Student",
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: education.university
  },
  sameAs: [siteConfig.github, siteConfig.linkedIn],
  description: siteConfig.description
}).replace(/</g, "\\u003c");
---

<BaseLayout
  title={siteConfig.title}
  description={siteConfig.description}
  currentPath="/"
  jsonLd={personJsonLd}
>
  <section class="container pb-4 pt-6 md:pb-4 md:pt-6">
    <div class="hero-card grid gap-6 md:grid-cols-[1fr_auto] md:items-start md:gap-10">
      <!-- Left: primary content -->
      <div>
        <p class="kicker hero-seq" style="animation-delay: 80ms">Computer Engineering · SJSU</p>
        <h1 class="hero-title">
          <span class="hero-line hero-seq" style="animation-delay: 160ms">Christopher Velez</span>
          <span class="hero-line hero-seq" style="animation-delay: 260ms">explores robotics, AI,</span>
          <span class="hero-line hero-seq" style="animation-delay: 360ms">and interactive systems.</span>
        </h1>
        <p class="hero-subtitle hero-seq" style="animation-delay: 480ms">
          SJSU B.S. Computer Engineering student working with Pepper and LG CLOi robots,
          AI advising, and XR, with foundations in C, x86 assembly, and digital logic.
        </p>
        <p class="now-line hero-seq" style="animation-delay: 530ms">
          <span class="now-label">Now</span>
          Robot Pilot at Figure AI (via Insight Global), Aug 2026–present: humanoid robot teleoperation and data collection.
        </p>
        <div class="mt-5 flex flex-wrap gap-3 hero-seq" style="animation-delay: 580ms">
          <a href={withBase("/projects")} class="btn">View Projects</a>
          <a href={hrefFor(siteConfig.resumePath)} class="btn btn-secondary" download>
            Download CV (PDF)
          </a>
        </div>
      </div>

      <!-- Right: proof points -->
      <aside class="w-full md:w-72 lg:w-80" aria-labelledby="proof-points-heading">
        <p class="focus-areas-label" id="proof-points-heading">Proof</p>
        <ul class="mt-3 space-y-2 stagger-children">
          {proofPoints.map((item) => (
            <li class="focus-area-card">
              <span class="focus-area-accent" aria-hidden="true" />
              <span class="focus-area-text">
                {"href" in item ? (
                  <a href={withBase(item.href)} class="proof-link">{item.label}</a>
                ) : (
                  <span class="text-white">{item.label}</span>
                )}
                <span class="mt-0.5 block text-xs font-normal text-neutral-400">{item.detail}</span>
              </span>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <section class="container pb-10 pt-6 md:pb-12 md:pt-8" id="featured-projects">
    <SectionHeading
      title="Selected projects"
      size="sm"
      description="An advising chatbot on Azure, public-facing XR, and a co-op game."
    />
    <div class="mt-5 grid gap-6 md:grid-cols-2 stagger-children">
      {featuredProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
    <div class="reveal mt-8">
      <a
        href={withBase("/projects")}
        class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-accent-400 hover:text-accent-300 hover:gap-2.5"
        style="transition: color 160ms ease, gap 160ms ease;"
      >
        All {projects.length} projects
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>

  <section class="container py-14 md:py-20">
    <SectionHeading
      title="Experience"
      description="Human-robot interaction, robotics demos, and XR systems for research and public engagement."
    />
    <div class="timeline mt-10">
      {experiences.map((item) => (
        <ExperienceCard item={item} />
      ))}
    </div>
    <div class="reveal mt-7">
      <a href={withBase("/contact")} class="btn">
        Start a conversation
      </a>
    </div>
  </section>
</BaseLayout>
