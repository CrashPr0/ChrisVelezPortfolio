---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { siteConfig } from "@/data/site";
import { hrefFor } from "@/utils/paths";
---

<BaseLayout
  title="Contact | Christopher Velez"
  description="Contact Christopher Velez, graduating December 2026 and seeking full-time roles in forward-deployed, solutions, robotics, AI, and XR engineering, and technical sales."
  currentPath="/contact"
>
  <section class="container py-16 md:py-20">
    <SectionHeading level="h1"
      title="Let&apos;s talk about full-time roles"
      description="Graduating December 2026 (BS Computer Engineering, SJSU), seeking full-time roles in forward-deployed, solutions, robotics, AI, and XR engineering, and technical sales."
    />
  </section>

  <section class="container pb-20">
    <div class="contact-shell reveal">
      <div class="contact-grid">
        <article class="rounded-lg border border-white/[0.06] bg-surface-800/40 p-6">
          <h2 class="font-display text-xl font-bold text-white">Opportunities</h2>
          <p class="mt-4 text-sm text-neutral-400">
            If your team is hiring for one of these roles, or working on robotics, AI, or XR systems, I would
            love to connect.
          </p>
          <ul class="mt-5 space-y-2 text-sm text-neutral-400">
            <li class="timeline-bullet">Forward-deployed and solutions engineering</li>
            <li class="timeline-bullet">Robotics and AI engineering</li>
            <li class="timeline-bullet">XR engineering</li>
            <li class="timeline-bullet">Technical sales</li>
          </ul>
        </article>

        <article class="rounded-lg border border-white/[0.06] bg-surface-800/40 p-6">
          <h2 class="font-display text-xl font-bold text-white">Direct Contact</h2>
          <div class="mt-5 space-y-4 text-sm text-neutral-300">
            <p>
              <span class="text-neutral-400">Email</span><br />
              <a href={`mailto:${siteConfig.email}`} class="footer-link">{siteConfig.email}</a>
            </p>
            <button class="btn btn-sm btn-secondary" data-copy-email data-email={siteConfig.email}>
              Copy Email
            </button>
            <p>
              <span class="text-neutral-400">LinkedIn</span><br />
              <a href={hrefFor(siteConfig.linkedIn)} target="_blank" rel="noopener noreferrer" class="footer-link">
                {siteConfig.linkedIn}
              </a>
            </p>
            <p>
              <span class="text-neutral-400">GitHub</span><br />
              <a href={hrefFor(siteConfig.github)} target="_blank" rel="noopener noreferrer" class="footer-link">
                {siteConfig.github}
              </a>
            </p>
          </div>
          <p class="mt-5 text-[0.65rem] font-semibold uppercase tracking-[0.25em] text-accent-400" data-copy-status aria-live="polite"></p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
